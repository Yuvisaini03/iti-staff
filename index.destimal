<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ITI Staff Portal</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f7fb;
      color: #222;
    }

    /* Header */
    header {
      background: linear-gradient(135deg, #003b73, #0074b7);
      color: white;
      text-align: center;
      padding: 30px 15px;
    }

    header h1 {
      font-size: 34px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 17px;
    }

    /* Navigation */
    nav {
      background: #002b52;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 5px;
      padding: 10px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav a {
      color: white;
      text-decoration: none;
      padding: 12px 18px;
      border-radius: 6px;
      transition: 0.3s;
    }

    nav a:hover {
      background: #008bd2;
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 55px 20px;
      background: white;
    }

    .hero h2 {
      color: #003b73;
      font-size: 32px;
      margin-bottom: 12px;
    }

    .hero p {
      font-size: 18px;
      color: #555;
    }

    /* Staff Section */
    .staff-section {
      padding: 45px 7%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 35px;
    }

    .section-title h2 {
      color: #003b73;
      font-size: 30px;
    }

    .section-title p {
      color: #666;
      margin-top: 8px;
    }

    .staff-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 25px;
    }

    /* Staff Card */
    .staff-card {
      background: white;
      border-radius: 15px;
      overflow: hidden;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.10);
      transition: 0.3s;
    }

    .staff-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.18);
    }

    .staff-photo {
      width: 140px;
      height: 140px;
      margin: 25px auto 15px;
      border-radius: 50%;
      overflow: hidden;
      border: 5px solid #0074b7;
    }

    .staff-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .staff-card h3 {
      color: #003b73;
      font-size: 21px;
      margin: 10px 0 5px;
    }

    .staff-card .designation {
      color: #0074b7;
      font-weight: bold;
    }

    .staff-card .trade {
      color: #666;
      margin: 8px 15px 20px;
    }

    /* About */
    .about {
      background: #eaf4ff;
      padding: 45px 8%;
      text-align: center;
    }

    .about h2 {
      color: #003b73;
      margin-bottom: 15px;
    }

    .about p {
      max-width: 850px;
      margin: auto;
      line-height: 1.7;
      color: #444;
    }

    /* Contact */
    .contact {
      padding: 45px 8%;
      text-align: center;
      background: white;
    }

    .contact h2 {
      color: #003b73;
      margin-bottom: 20px;
    }

    .contact p {
      margin: 10px;
      color: #555;
    }

    /* Footer */
    footer {
      background: #002b52;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 0;
    }

    /* Mobile */
    @media (max-width: 600px) {
      header h1 {
        font-size: 26px;
      }

      .hero h2 {
        font-size: 25px;
      }

      nav a {
        padding: 9px 12px;
        font-size: 14px;
      }
    }
  </style>
</head>

<body>

  <!-- Header -->
  <header>
    <h1>🏫 Government ITI</h1>
    <p>Industrial Training Institute</p>
  </header>

  <!-- Navigation -->
  <nav>
    <a href="#home">Home</a>
    <a href="#staff">Staff</a>
    <a href="#about">About ITI</a>
    <a href="#contact">Contact</a>
  </nav>

  <!-- Hero -->
  <section class="hero" id="home">
    <h2>Welcome to ITI Staff Portal</h2>
    <p>Meet our experienced and dedicated teaching staff</p>
  </section>

  <!-- Staff -->
  <section class="staff-section" id="staff">

    <div class="section-title">
      <h2>Our Staff</h2>
      <p>ITI के शिक्षकों एवं कर्मचारियों की जानकारी</p>
    </div>

    <div class="staff-container">

      <!-- Staff 1 -->
      <div class="staff-card">
        <div class="staff-photo">
          <img src="https://via.placeholder.com/150" alt="Principal">
        </div>

        <h3>Mr. Raj Kumar</h3>
        <p class="designation">Principal</p>
        <p class="trade">Government ITI</p>
      </div>

      <!-- Staff 2 -->
      <div class="staff-card">
        <div class="staff-photo">
          <img src="https://via.placeholder.com/150" alt="Instructor">
        </div>

        <h3>Mr. Amit Sharma</h3>
        <p class="designation">Senior Instructor</p>
        <p class="trade">Electrician Trade</p>
      </div>

      <!-- Staff 3 -->
      <div class="staff-card">
        <div class="staff-photo">
          <img src="https://via.placeholder.com/150" alt="Instructor">
        </div>

        <h3>Ms. Neha Devi</h3>
        <p class="designation">Instructor</p>
        <p class="trade">COPA Trade</p>
      </div>

      <!-- Staff 4 -->
      <div class="staff-card">
        <div class="staff-photo">
          <img src="https://via.placeholder.com/150" alt="Instructor">
        </div>

        <h3>Mr. Sandeep Kumar</h3>
        <p class="designation">Instructor</p>
        <p class="trade">Fitter Trade</p>
      </div>

      <!-- Staff 5 -->
      <div class="staff-card">
        <div class="staff-photo">
          <img src="https://via.placeholder.com/150" alt="Instructor">
        </div>

        <h3>Ms. Priya Sharma</h3>
        <p class="designation">Instructor</p>
        <p class="trade">Computer Trade</p>
      </div>

      <!-- Staff 6 -->
      <div class="staff-card">
        <div class="staff-photo">
          <img src="https://via.placeholder.com/150" alt="Staff">
        </div>

        <h3>Mr. Manoj Kumar</h3>
        <p class="designation">Workshop Instructor</p>
        <p class="trade">Welder Trade</p>
      </div>

    </div>
  </section>

  <!-- About -->
  <section class="about" id="about">
    <h2>About Our ITI</h2>

    <p>
      Government ITI का उद्देश्य युवाओं को आधुनिक तकनीकी एवं
      व्यावसायिक प्रशिक्षण प्रदान करना है, ताकि विद्यार्थी
      अपने कौशल को विकसित करके रोजगार एवं स्वरोजगार के अवसर
      प्राप्त कर सकें।
    </p>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <h2>Contact Us</h2>

    <p>📍 Address: Your ITI Address, Punjab, India</p>
    <p>📞 Phone: +91 XXXXX XXXXX</p>
    <p>📧 Email: iti@example.com</p>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2026 Government ITI | All Rights Reserved</p>
  </footer>

</body>
</html>